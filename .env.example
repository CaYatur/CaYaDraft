# Fallback only. The GitHub account that installs the app is the admin and the mention.
# These two are used when a delivery has no installation account.
OWNER_LOGIN=your-github-login
MENTION_LOGIN=your-github-login

# Local model. The issue text stays on this machine.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT=180
OLLAMA_NUM_CTX=8192

# Webhook secret is only for `python -m cayadraft` on a server with a public URL.
# Local polling (`python -m cayadraft poll`) does not use it.
WEBHOOK_SECRET=change-me
# The process stays on localhost. The public site proxies this prefix to it.
HOST=127.0.0.1
PORT=8787
PUBLIC_PREFIX=/cayadraft
PUBLIC_URL=https://your-host.example/cayadraft
WEBHOOK_PATH=/webhook

# GitHub App (preferred). Comments and commits can belong to CaYaDraft.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=cayadraft.pem

# Personal access token fallback. Comments then appear as that user.
# Leave this empty when GITHUB_APP_ID is set.
GITHUB_TOKEN=

# Used by local git only. GitHub App commits use the app identity, so leave the API author unset.
GIT_AUTHOR_NAME=CaYaDraft
GIT_AUTHOR_EMAIL=cayadraft@example.com

# Optional. Comma-separated owner/repo list. Empty means every repo that sends a webhook.
REPO_ALLOWLIST=

# Limits for a simple fix.
MAX_EDIT_FILES=5
MAX_EDITS=8
MAX_DIFF_LINES=300
